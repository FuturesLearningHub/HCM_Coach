{
  "name": "hcm-coach",
  "private": true,
  "version": "0.1.5",
  "description": "HCM Coach for HCM Academy: an on-demand process guide for Oracle HCM (Chrome side panel), its practice app, and the content service that feeds it",
  "workspaces": [
    "web",
    "extension"
  ],
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "build:ext": "npm run build -w extension",
    "test:e2e": "node scripts/e2e.mjs",
    "build:guide": "HCM_COACH_MODE=guide npm run build -w extension",
    "test:guide": "node scripts/e2e-guide.mjs",
    "knowledge": "node scripts/build-knowledge.mjs",
    "test:live": "node scripts/e2e-live.mjs",
    "test:app": "node scripts/e2e-app.mjs",
    "build:app": "HCM_COACH_MODE=guide HCM_COACH_CONTENT_URL=https://hcm-coach.vercel.app npm run build -w extension"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
